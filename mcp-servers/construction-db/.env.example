# STAIRS is restored into PostgreSQL. Use a read-only role.
CONSTRUCTION_DB_STAIRS_DSN=postgresql://stairs_reader:change-me@localhost:5432/stairs

# Maximum rows returned by every schema/query tool (default: 100).
CONSTRUCTION_DB_MAX_ROWS=100
# PostgreSQL statement timeout in milliseconds (default: 5000).
CONSTRUCTION_DB_STATEMENT_TIMEOUT_MS=5000
